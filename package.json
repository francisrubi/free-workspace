{
  "name": "free-workspace",
  "version": "0.1.0",
  "description": "Canvas infinito para desenvolvimento: terminais, sessões de IA, arquivos, notas, ToDos e screenshots no mesmo mural.",
  "license": "MIT",
  "main": "out/main/index.js",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "start": "electron-vite preview",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test:e2e": "electron-vite build && node test/e2e/run.mjs",
    "dist": "electron-vite build && electron-builder",
    "dist:dir": "electron-vite build && electron-builder --dir",
    "prepare": "git config core.hooksPath .githooks || exit 0"
  },
  "dependencies": {
    "@lydell/node-pty": "^1.2.0-beta.15"
  },
  "devDependencies": {
    "@codemirror/lang-markdown": "^6.5.2",
    "@codemirror/language-data": "^6.5.2",
    "@codemirror/theme-one-dark": "^6.1.3",
    "@types/node": "^26.6.3",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@uiw/react-codemirror": "^4.25.12",
    "@vitejs/plugin-react": "^5.2.0",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/xterm": "^6.0.0",
    "@xyflow/react": "^12.12.0",
    "electron": "^44.5.0",
    "electron-builder": "^26.15.3",
    "electron-vite": "^5.0.0",
    "marked": "^18.0.14",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "typescript": "^7.0.2",
    "vite": "^7.3.6"
  },
  "productName": "Free Workspace",
  "author": "Francis Rotilli",
  "build": {
    "appId": "dev.freeworkspace.app",
    "productName": "Free Workspace",
    "directories": {
      "output": "dist"
    },
    "files": [
      "out/**",
      "package.json"
    ],
    "npmRebuild": false,
    "asarUnpack": [
      "**/node_modules/@lydell/node-pty*/**"
    ],
    "win": {
      "target": [
        "nsis",
        "portable"
      ]
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true
    },
    "portable": {
      "artifactName": "${productName}-${version}-portable.${ext}"
    },
    "mac": {
      "target": [
        "dmg"
      ],
      "category": "public.app-category.developer-tools"
    },
    "linux": {
      "target": [
        "AppImage",
        "deb"
      ],
      "category": "Development",
      "maintainer": "Francis Rotilli"
    }
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/francisrubi/free-workspace.git"
  },
  "homepage": "https://github.com/francisrubi/free-workspace"
}
